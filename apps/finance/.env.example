# Alethical Finance web app. Copy to .env.local for `pnpm --dir apps/finance dev`.
# Publishable values only: everything here is readable in the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_API_BASE_URL=http://localhost:8000
VITE_GOOGLE_SIGN_IN=off   # on only once Supabase allows this app's return address
