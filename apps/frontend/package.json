{
  "name": "frontend",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "node ./scripts/start-expo.mjs",
    "android": "node ./scripts/start-expo.mjs --android",
    "android:release": "node ./scripts/build-android-release.mjs",
    "android:sync-network": "node ./scripts/sync-android-dev-network-security.mjs",
    "ios": "node ./scripts/start-expo.mjs --ios",
    "web": "node ./scripts/start-expo.mjs --web",
    "build": "node ./scripts/check-traffic-production-env.mjs && node ./scripts/check-brand-assets.mjs && node ./scripts/start-expo.mjs export --platform web && node ./scripts/optimize-release-program.mjs && node ./scripts/check-release-assets.mjs && node ./scripts/check-icon-bundle.mjs && node ./scripts/check-first-load-budget.mjs",
    "brand:generate": "node ./scripts/generate-brand-assets.mjs",
    "brand:check": "node ./scripts/check-brand-assets.mjs",
    "check:expo-packages": "node ./scripts/check-expo-packages.mjs",
    "check:build-tool-security": "node ./scripts/check-build-tool-security.mjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "export:web": "node ./scripts/start-expo.mjs export --platform web",
    "ios:simulator": "node ./scripts/with-root-env.mjs eas build:run --platform ios --profile simulator",
    "build:ios:simulator": "node ./scripts/with-root-env.mjs eas build --platform ios --profile simulator",
    "build:ios:preview": "node ./scripts/with-root-env.mjs eas build --platform ios --profile preview",
    "build:ios:testflight": "node ./scripts/with-root-env.mjs eas build --platform ios --profile production",
    "submit:ios:testflight": "node ./scripts/with-root-env.mjs eas submit --platform ios --profile production --latest"
  },
  "dependencies": {
    "@expo/dom-webview": "57.0.1",
    "@expo/metro-runtime": "57.0.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "7.15.11",
    "@react-navigation/elements": "2.9.15",
    "@react-navigation/native": "7.2.2",
    "@react-navigation/native-stack": "7.14.12",
    "@supabase/auth-js": "2.112.2",
    "@supabase/supabase-js": "2.112.2",
    "@tanstack/react-query": "5.101.4",
    "@vercel/analytics": "2.0.1",
    "expo": "57.0.11",
    "expo-auth-session": "57.0.6",
    "expo-clipboard": "~57.0.1",
    "expo-linear-gradient": "57.0.1",
    "expo-splash-screen": "57.0.5",
    "expo-status-bar": "57.0.1",
    "expo-web-browser": "57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.2.4",
    "eas-cli": "21.6.0",
    "jsdom": "^30.0.1",
    "pngjs": "7.0.0",
    "prettier": "3.9.6",
    "terser": "5.46.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo",
        "@expo/metro-runtime",
        "expo-auth-session",
        "expo-splash-screen"
      ]
    }
  },
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "volta": {
    "extends": "../../package.json"
  }
}
