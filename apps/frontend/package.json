{
  "name": "frontend",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "node ./scripts/start-expo.mjs",
    "android": "node ./scripts/start-expo.mjs --android",
    "android:release": "node ./scripts/build-android-release.mjs",
    "android:sync-network": "node ./scripts/sync-android-dev-network-security.mjs",
    "ios": "node ./scripts/start-expo.mjs --ios",
    "web": "node ./scripts/start-expo.mjs --web",
    "build": "node ./scripts/start-expo.mjs export --platform web && node ./scripts/check-release-assets.mjs && node ./scripts/check-icon-bundle.mjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "export:web": "node ./scripts/start-expo.mjs export --platform web",
    "ios:simulator": "node ./scripts/with-root-env.mjs eas build:run --platform ios --profile simulator",
    "build:ios:simulator": "node ./scripts/with-root-env.mjs eas build --platform ios --profile simulator",
    "build:ios:preview": "node ./scripts/with-root-env.mjs eas build --platform ios --profile preview",
    "build:ios:testflight": "node ./scripts/with-root-env.mjs eas build --platform ios --profile production",
    "submit:ios:testflight": "node ./scripts/with-root-env.mjs eas submit --platform ios --profile production --latest"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.8",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-navigation/bottom-tabs": "7.18.14",
    "@react-navigation/elements": "2.9.36",
    "@react-navigation/native": "7.3.14",
    "@react-navigation/native-stack": "7.18.6",
    "@supabase/supabase-js": "2.105.3",
    "@tanstack/react-query": "5.101.4",
    "expo": "57.0.9",
    "expo-auth-session": "57.0.5",
    "expo-linear-gradient": "57.0.1",
    "expo-status-bar": "57.0.1",
    "expo-web-browser": "57.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.5",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "eas-cli": "20.0.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "private": true,
  "packageManager": "pnpm@10.33.0"
}
