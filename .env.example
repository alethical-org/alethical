# ==============================================================================
# Alethical environment template
#
# Copy this file to `.env` at the repo root, then fill in the values marked
# "SET THIS". Everything else already has a working default and can be left as-is
# for local development.
#
#   cp .env.example .env
#
# The backend + ingestion pipeline auto-load `.env` from the repo root, and the
# Expo frontend reads the same file for its EXPO_PUBLIC_* values.
#
# NEVER commit your real `.env`. NEVER put a service-role / secret key in any
# EXPO_PUBLIC_* variable — those are bundled into the shipped client.
#
# Note: the government data sources (Revisor bills, legislator roster, chamber
# votes) are public and need NO environment variables at all. Only district
# lookup, OpenAI, Supabase auth, and map tiles read anything below.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database (backend + pipeline)
# ------------------------------------------------------------------------------
# Local Docker Compose provides Postgres automatically (user/pass/db all
# "alethical", host port 54329). Only set DATABASE_URL if you run the backend
# OUTSIDE compose against that database:
# DATABASE_URL=postgresql+psycopg://alethical:alethical@localhost:54329/alethical

ALETHICAL_DATABASE_TARGET=local          # local | production (compose picks the DB URL)
# ALETHICAL_PIPELINE_TARGET=local        # default --target for the Oban pipeline CLI
# OBAN_DSN=                              # optional: separate DSN for the Oban job queue

# ------------------------------------------------------------------------------
# Supabase — auth (all environments) + production database
# From Supabase dashboard > Project Settings > API. Use the PUBLISHABLE/ANON key.
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx        # SET THIS (or SUPABASE_ANON_KEY below)
# SUPABASE_ANON_KEY=                                # legacy alias, accepted as a fallback

# Production database via the Supabase pooler (only when ALETHICAL_DATABASE_TARGET=production):
# SUPABASE_PROJECT_URL=https://your-project.supabase.co
# SUPABASE_PROJECT_REF=your-project-ref
# SUPABASE_DB_PASSWORD=                             # SET THIS for the production DB
# SUPABASE_POOLER_HOST=aws-1-us-east-2.pooler.supabase.com

# ------------------------------------------------------------------------------
# Local dev + internal auth
# ------------------------------------------------------------------------------
# Static bearer token that authenticates as a demo user WITHOUT Supabase.
# Convenient for local dev; leave UNSET in any shared/staging/production env
# (it is an authentication bypass).
ALETHICAL_DEV_AUTH_TOKEN=local-dev-token

# Guards the /internal/v1/* endpoints (ingestion status, Oban dashboard).
# The value below is the well-known default in code — OVERRIDE it with a strong
# secret in any deployed environment.
INTERNAL_API_TOKEN=dev-internal-token              # SET a strong value in production

# ------------------------------------------------------------------------------
# CORS + logging (backend)
# ------------------------------------------------------------------------------
ALETHICAL_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006
# ALETHICAL_LOG_LEVEL=INFO
# ALETHICAL_LOG_DIR=/app/logs
# ALETHICAL_SKIP_MIGRATIONS=            # set to 1 to skip alembic upgrade on container start

# ------------------------------------------------------------------------------
# OpenAI — AI bill summaries (Batch API) + RAG chat synthesis
# All government data ingestion works WITHOUT this key; only AI features need it.
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-xxx                              # SET THIS to enable AI features
OPENAI_AI_ENRICHMENT_MODEL=gpt-4o-mini
# The model that writes every AI answer a reader sees. A bare name goes to OpenAI;
# prefix it with `anthropic:` to use a Claude model instead, which needs
# ANTHROPIC_API_KEY (#894). Keep this as it is unless you mean to change what every
# visitor reads and what every answer costs.
OPENAI_RAG_CHAT_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# District lookup — "Find My Legislator" (query-time)
# Public address APIs with working defaults; override only to point at a mirror/mock.
# House, Senate, and congressional district lines are bundled official files.
# ------------------------------------------------------------------------------
ALETHICAL_CENSUS_GEOCODER_URL=https://geocoding.geo.census.gov/geocoder/locations/onelineaddress
ALETHICAL_CENSUS_BENCHMARK=Public_AR_Current
ALETHICAL_MN_ADDRESS_POINTS_URL=https://enterprise.gisdata.mn.gov/aghost/rest/services/us_mn_state_mngeo/loc_addresses_open/FeatureServer/0/query
ALETHICAL_HTTP_TIMEOUT_SECONDS=10
ALETHICAL_LOOKUP_RATE_PER_MIN=10
ALETHICAL_ADDRESS_SUGGESTION_RATE_PER_MIN=60

# ------------------------------------------------------------------------------
# Contact us email delivery — safe defaults send nothing
# ------------------------------------------------------------------------------
ALETHICAL_EMAIL_ENABLED=false
ALETHICAL_EMAIL_TRANSPORT=console        # console | dry_run | resend
# ALETHICAL_EMAIL_ALLOWLIST=ask@alethical.com,you@example.com
# ALETHICAL_EMAIL_FROM=Alethical <ask@alethical.com>
# RESEND_API_KEY=                       # backend secret; never EXPO_PUBLIC_*
ALETHICAL_CONTACT_RATE_PER_MIN=5

# ------------------------------------------------------------------------------
# Frontend (Expo) — EXPO_PUBLIC_* are bundled into the client: publishable only!
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # SET THIS (publishable only)
# Turn on only after Supabase custom SMTP is connected and all auth emails arrive.
EXPO_PUBLIC_EMAIL_PASSWORD_SIGN_IN_ENABLED=false
# Keep this equal to Supabase Auth's real email resend cooldown.
EXPO_PUBLIC_AUTH_RESEND_WAIT_SECONDS=60

# Public Traffic page. These are server-only Vercel settings, never EXPO_PUBLIC_*.
# Vercel access tokens can be limited to a team, not to one project. Keep this
# Alethical-team token sensitive; the Traffic route uses it only to read totals.
# VERCEL_ANALYTICS_ACCESS_TOKEN=
# VERCEL_ANALYTICS_PROJECT_ID=
# VERCEL_ANALYTICS_TEAM_ID=
# TRAFFIC_COUNTING_STARTED_AT=2026-08-14T00:00:00.000Z
# Optional comma-separated Supabase account IDs whose signed-in browsing is excluded.
# TRAFFIC_EXCLUDED_ACCOUNT_IDS=

# Map tiles for the Find-My-Legislator map (OpenStreetMap defaults shown).
EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
EXPO_PUBLIC_MAP_TILE_USER_AGENT="Alethical/0.1 (+https://www.alethical.com)"
# EXPO_PUBLIC_OPENSTREETMAP_TILE_URL=  # optional; takes precedence over EXPO_PUBLIC_MAP_TILE_URL

# ------------------------------------------------------------------------------
# Local dev port overrides (Docker Compose) — optional
# ------------------------------------------------------------------------------
# BACKEND_PORT=8000
# FRONTEND_PORT=19006
# DB_PORT=54329

# ------------------------------------------------------------------------------
# Production database + paid APIs — NOT needed for local dev, but REQUIRED to
# rebuild this file from scratch. Listed because on 2026-07-30 the real `.env`
# was accidentally emptied and this example documented 18 of the 31 settings the
# code actually reads, so the 13 that mattered most had to be rediscovered by
# grepping the source. Names only; values live in the owning service, or in
# Railway (backend) and Vercel (frontend), which hold working copies.
# ------------------------------------------------------------------------------
# ALETHICAL_DATABASE_TARGET=local          # 'local' or 'production'; anything else errors
# SUPABASE_PROJECT_URL=                    # https://<ref>.supabase.co — Supabase dashboard
# SUPABASE_DB_PASSWORD=                    # Supabase dashboard; with the line above this
#                                          # is all `target=production` needs
# SUPABASE_PROJECT_REF=                    # optional; otherwise derived from the URL above
# SUPABASE_POOLER_HOST=                    # optional; overrides the default pooler host
# DATABASE_URL=                            # optional; a full URL, bypassing the two above
# ANTHROPIC_API_KEY=                       # bill summaries (`anthropic_enrichment`)
# VOYAGE_API_KEY=                          # search embeddings
# OPENAI_ASK_ROUTER_MODEL=                 # optional; overrides the Ask router's model
# OPENAI_RAG_EMBEDDING_MODEL=              # optional; overrides the embedding model
# ALETHICAL_PIPELINE_TARGET=               # optional; database target for pipeline runs
# ALETHICAL_CLAUDE_CLI=claude              # optional; path to the Claude CLI binary
# ALETHICAL_LOG_LEVEL=                     # optional; also _DIR, _FILE, _MAX_BYTES,
#                                          # _BACKUP_COUNT
#
# Campaign finance keeps each downloaded file's exact bytes, because the Board
# publishes no archive: its download links never change and the file behind each one
# is replaced as it grows, so a file we fail to keep cannot be fetched again. These
# 4 are the Storage-scoped S3 credentials for the private `raw-source-files` bucket
# (Supabase dashboard > Storage > S3 access keys). Storage-scoped on purpose: they
# bypass row security inside Storage and cannot touch the database, so a leak cannot
# reach any data. A dry run needs none of them (#1328).
# SUPABASE_STORAGE_S3_ENDPOINT=            # https://<ref>.supabase.co/storage/v1/s3
# SUPABASE_STORAGE_S3_REGION=              # the project's region, e.g. us-east-2
# SUPABASE_STORAGE_S3_ACCESS_KEY_ID=
# SUPABASE_STORAGE_S3_SECRET_ACCESS_KEY=
#
# The second copy of those same files, on Cloudflare R2. Supabase's own
# documentation says database backups "do not include objects you store via the
# Storage API", so without this the bucket above is the only copy and nothing
# protects it. The key is scoped to the one bucket, so listing all buckets is
# refused and that is correct. Only `scripts/mirror_raw_files.py` and the daily job
# `.github/workflows/mirror-raw-files.yml` read these; ingestion never does (#1402).
# CLOUDFLARE_R2_ENDPOINT=                  # https://<account-id>.r2.cloudflarestorage.com
# CLOUDFLARE_R2_BUCKET=                    # raw-source-files-backup
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
