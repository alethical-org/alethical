{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --dir apps/frontend run build",
  "outputDirectory": "apps/frontend/dist",
  "functions": {
    "api/page.ts": {
      "includeFiles": "apps/frontend/dist/index.html"
    }
  },
  "trailingSlash": false,
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    {
      "source": "/sitemaps/:section.xml",
      "destination": "/api/sitemap?section=:section"
    },
    {
      "source": "/((?!api/|_expo/).*)",
      "destination": "/api/page?path=/$1"
    }
  ]
}
